{
  "name": "begitra",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tests/tsconfig.json",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "1.48.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "pinia": "^4.0.3",
    "valibot": "^1.5.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.4.12"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.1",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.5.3"
}
